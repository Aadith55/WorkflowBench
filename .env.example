# Copy to .env. Never commit the real .env file.
# Optional Gemini API free-tier access (Google AI Studio).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional OpenAI API access. OpenAI API usage may require paid billing credits.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional verified prices in USD per 1 million tokens for OpenAI cost estimates.
# Leave blank to report token usage only.
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=

WORKFLOWBENCH_DB=workflowbench.db
